        "truncated": false,
        "evidence": [
          {
            "sql": "SELECT date_trunc('month',header.confirmed_date)::date AS dimension, COALESCE(SUM(line.sales_amount),0) AS value FROM fact_sales_detail line JOIN fact_sales_order header\nON header.order_id=line.order_id WHERE header.order_status='completed'\nAND header.confirmed_date >= :start_date AND header.confirmed_date < :end_date\nAND (CAST(:country AS text) IS NULL OR EXISTS (SELECT 1 FROM dim_region region\n    WHERE region.region_id=header.region_id AND region.region_name=:country))\nAND (CAST(:customer_code AS text) IS NULL OR EXISTS (SELECT 1 FROM dim_customer customer\n    WHERE customer.customer_id=header.customer_id AND customer.customer_code=:customer_code))\nAND (CAST(:product_code AS text) IS NULL OR EXISTS (SELECT 1 FROM dim_product product\n    WHERE product.product_id=line.product_id AND product.product_code=:product_code)) GROUP BY date_trunc('month',header.confirmed_date)::date",
            "parameters": {
              "start_date": "2011-01-01",
              "end_date": "2011-02-01",
              "country": "United Kingdom",
              "customer_code": null,
