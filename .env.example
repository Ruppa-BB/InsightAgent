DATABASE_URL=postgresql+psycopg://insight_reader:CHANGE_ME@localhost:5432/insight_agent
QUERY_TIMEOUT_MS=5000
# demo: bounded rule parser, real DB queries; not an LLM.
LLM_PROVIDER=demo
# Set all three below, then change LLM_PROVIDER=openai_compatible.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# DeepSeek low-cost setup: set LLM_PROVIDER=deepseek, LLM_BASE_URL=https://api.deepseek.com, LLM_MODEL=deepseek-flash.
LLM_MAX_OUTPUT_TOKENS=700
LLM_CACHE_SECONDS=3600
